#!/usr/bin/env bash
# scripts/kubectl: host-side shim: delegate to the toolbox container.
# Lets a grader use native-style commands without local kubectl:
#   ./scripts/kubectl get nodes -L acme.io/capacity -L acme.io/node-type
set -eu
if command -v docker >/dev/null 2>&1 && docker compose ps toolbox 2>/dev/null | grep -q tool; then\n  exec docker compose exec -T toolbox kubectl "$@"\nelif ! command -v kubectl >/dev/null 2>&1; then
  exec docker compose exec -T toolbox kubectl "$@"
fi
exec kubectl "$@"

